// Swedwise IMS Platform Database Schema
// Supports document management, LMS, and user tracking

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// User Management & Authentication
// ============================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  role          UserRole  @default(EMPLOYEE)
  department    String?
  jobTitle      String?
  officeLocation String?
  isActive      Boolean   @default(true)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?

  // Relations
  accounts      Account[]
  sessions      Session[]

  // Document relations
  ownedDocuments    Document[]     @relation("DocumentOwner")
  approvedDocuments Document[]     @relation("DocumentApprover")
  acknowledgments   Acknowledgment[]

  // Training relations
  trainingProgress  TrainingProgress[]
  assessmentAttempts AssessmentAttempt[]
  certificates      Certificate[]

  // Audit relations
  auditLogs         AuditLog[]
}

enum UserRole {
  ADMIN
  IMS_OWNER
  CISO
  QUALITY_LEAD
  ENVIRONMENTAL_LEAD
  MANAGER
  EMPLOYEE
  AUDITOR
  EXTERNAL
}

// NextAuth.js models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================
// Document Management
// ============================================

model Document {
  id              String           @id @default(cuid())
  documentId      String           @unique // SW-ISMS-POL-001 format
  path            String           @unique // File path in content repo
  title           String
  docType         DocumentType
  status          DocumentStatus   @default(DRAFT)
  classification  Classification   @default(INTERNAL)
  version         String           @default("1.0")

  // Ownership
  ownerId         String?
  owner           User?            @relation("DocumentOwner", fields: [ownerId], references: [id])

  // Approval
  approvedById    String?
  approvedBy      User?            @relation("DocumentApprover", fields: [approvedById], references: [id])
  approvedAt      DateTime?

  // Dates
  effectiveDate   DateTime?
  reviewDate      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  // Standards applicability
  standards       String[]         // ["ISO 9001", "ISO 27001"]

  // Relations
  versions        DocumentVersion[]
  acknowledgments Acknowledgment[]
  course          Course?

  @@index([docType])
  @@index([status])
}

enum DocumentType {
  POLICY
  PROCEDURE
  GUIDELINE
  ROLE
  FORM
  TRAINING
  REGISTER
  MANUAL
}

enum DocumentStatus {
  DRAFT
  REVIEW
  APPROVED
  OBSOLETE
}

enum Classification {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
  RESTRICTED
}

model DocumentVersion {
  id            String   @id @default(cuid())
  documentId    String
  document      Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version       String
  gitCommit     String?  // Git commit SHA
  changeSummary String?  @db.Text
  createdAt     DateTime @default(now())
  createdBy     String?

  @@index([documentId])
}

model Acknowledgment {
  id            String   @id @default(cuid())
  documentId    String
  document      Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  acknowledgedAt DateTime @default(now())
  version       String   // Version that was acknowledged

  @@unique([documentId, userId])
  @@index([userId])
}

// ============================================
// Learning Management System (LMS)
// ============================================

model Course {
  id              String   @id @default(cuid())
  courseId        String   @unique // e.g., "security-awareness"
  title           String
  description     String?  @db.Text

  // Link to training document
  documentId      String?  @unique
  document        Document? @relation(fields: [documentId], references: [id])

  // Course settings
  durationMinutes Int      @default(30)
  targetAudience  String[] // ["all_staff", "developers", "managers"]
  requiredFor     String[] // ["new_hire", "annual_refresh"]
  validityMonths  Int      @default(12)
  isActive        Boolean  @default(true)

  // Assessment settings
  passingScore    Int      @default(80)
  attemptsAllowed Int      @default(3)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  modules         CourseModule[]
  progress        TrainingProgress[]
  assessments     Assessment[]
  certificates    Certificate[]

  @@index([isActive])
}

model CourseModule {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  order       Int
  contentPath String?  // Path to markdown content
  durationMinutes Int  @default(10)

  @@index([courseId])
}

model TrainingProgress {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  status      ProgressStatus @default(NOT_STARTED)
  progress    Int            @default(0) // Percentage 0-100
  startedAt   DateTime?
  completedAt DateTime?
  dueDate     DateTime?

  @@unique([userId, courseId])
  @@index([userId])
  @@index([status])
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  EXPIRED
}

model Assessment {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  questions   Json     // Array of question objects

  attempts    AssessmentAttempt[]

  @@index([courseId])
}

model AssessmentAttempt {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  score        Int
  passed       Boolean
  answers      Json       // User's answers
  attemptedAt  DateTime   @default(now())

  @@index([userId])
  @@index([assessmentId])
}

model Certificate {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  issuedAt    DateTime @default(now())
  expiresAt   DateTime
  certificateNumber String @unique

  @@index([userId])
  @@index([expiresAt])
}

// ============================================
// Audit & Compliance
// ============================================

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  action      String   // e.g., "document.view", "training.complete"
  entityType  String   // e.g., "Document", "Course"
  entityId    String?
  metadata    Json?    // Additional context
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}
